{
  "name": "@ekg/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plant Pulse operator frontend: the Risk inbox screen over the plant-pulse-api contract.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "VITEST_STORYBOOK=false vitest run",
    "test:unit": "vitest run --project unit",
    "test:stories": "VITEST_STORYBOOK=false vitest run --project storybook",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "regen-contracts": "node scripts/regen-contracts.mjs",
    "check-contracts": "node scripts/check-contracts.mjs",
    "record-fixtures": "node scripts/record-tab-fixtures.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "graphql": "^16.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "urql": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/client-preset": "^4.5.0",
    "@storybook/addon-a11y": "^9.0.0",
    "@storybook/addon-vitest": "^9.1.20",
    "@storybook/react-vite": "^9.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser": "^3.2.7",
    "axe-core": "4.13.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-storybook": "^9.0.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.4",
    "playwright": "^1.63.0",
    "storybook": "^9.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
