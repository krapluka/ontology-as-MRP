# LOCAL-ONLY defaults for Odoo + its Postgres in the local stack.
# NOT for production. Real secrets belong in an untracked .env, never here.
#
# Postgres here is ONLY Odoo's backing database, NOT a governed-truth store
# (source systems are the system of record). Model / OpenRouter creds do NOT
# belong here: put them in the repo-root .env (see .env.example: MODEL_API_KEY,
# MODEL_BASE_URL, CHAT_MODEL, EMBED_*).
POSTGRES_USER=ekg
POSTGRES_PASSWORD=ekg-local-only
POSTGRES_DB=ekg
# Odoo connects to the postgres service by name with these.
HOST=postgres
USER=ekg
PASSWORD=ekg-local-only
