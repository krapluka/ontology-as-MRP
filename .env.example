# Enterprise Knowledge Graph engine: environment template.
# Copy to .env and fill in. .env is gitignored.

# --- Engine ---
EKG_API_PORT=4000
RUST_LOG=info

# --- Provider-neutral model boundary ---
# Any OpenAI-compatible endpoint works (OpenRouter default; swap the base URL
# for Ollama http://localhost:11434/v1, vLLM, LM Studio, Azure, etc.).
# The default OpenRouter path is HTTPS and requires MODEL_API_KEY. A local http://
# endpoint (Ollama) needs no TLS and typically no key.
#
# By default the engine routes every model call through the Hayhooks runtime
# (EKG_COGNITION_ROUTE=runtime): the MODEL_* / EMBED_* settings below are
# then the runtime's, and only the runtime receives MODEL_API_KEY (the local stack
# blanks it for the backend). EKG_COGNITION_ROUTE=direct makes the engine call the
# endpoint itself with these settings (the fallback); any other value fails startup.
EKG_COGNITION_ROUTE=runtime
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_API_KEY=
CHAT_MODEL=openai/gpt-oss-120b
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_API_KEY=
EMBED_MODEL=qwen/qwen3-embedding-8b
# Pinned embedding width; a response of a different width is rejected. The bounded
# proposal agent generates via MODEL_BASE_URL/CHAT_MODEL (MODEL_API_KEY required
# for the HTTPS OpenRouter default; optional for a local http endpoint).
EMBED_DIM=4096

# --- Semantic layer: RDF triple store (GraphDB, graphwise/Ontotext) ---
GRAPHDB_URL=http://localhost:7200
GRAPHDB_REPOSITORY=ekg

# --- Dynamic layer: durable execution (Restate) ---
RESTATE_INGRESS_URL=http://localhost:8080
RESTATE_ADMIN_URL=http://localhost:9070
# The URL the Restate runtime dials the backend's SDK endpoint back at (used at
# registration). It depends on where the backend runs:
#   - containerized (the `just podman-local-up` stack): http://ekg-backend:9080,
#     over the compose network. `just podman-local-up` sets this on the service and
#     registers it for you, so leave this unset for that path.
#   - host-run (`just backend` + `just restate-register`): the container-to-host
#     hop http://host.containers.internal:9080 (the default `just restate-register`
#     uses). Set this only to override that host name.
# This host/container split is also why the substrate URLs here stay as localhost
# (the host seed/provision tools use them) while the container overrides them to
# compose DNS (graphdb:7200, odoo:8069, …) via its own environment.
# EKG_SERVICE_CALLBACK_URL=http://host.containers.internal:9080

# --- Event backbone: RdfChanged fan-out ---
# Which transport carries the RdfChanged fan-out.
#   in_process: a single-process tokio::broadcast; no broker, the default used by
#               `just check` and the hermetic unit tests.
#   nats:       durable NATS JetStream: replayable, survives a backend restart, and
#               lets independent consumers subscribe without polling the store.
# The local substrate opts into `nats`. An unknown value fails loud at startup.
EKG_EVENT_BUS=nats
# NATS client URL used when EKG_EVENT_BUS=nats (the `just podman-local-up` broker).
NATS_URL=nats://localhost:4222

# --- Cognition runtime: Haystack (Hayhooks) ---
# Where the engine reaches the runtime on the runtime route (the local stack sets
# http://hayhooks:1416 for the containerized backend).
HAYHOOKS_URL=http://localhost:1416
# The runtime's own limit per provider call; keep it at or above the engine's total
# cap (EKG_COGNITION_TOTAL_TIMEOUT_SECS, 120 by default) so the engine decides.
# PROVIDER_TIMEOUT_SECS=150

# --- Traces (optional; OpenTelemetry over OTLP/HTTP) ---
# Unset = nothing is exported and no connection is opened. With an endpoint set, the engine
# (the backend and `just agent-eval`) and the runtime export their spans there, and an agent
# run is one trace across both. Spans never carry prompt, answer, task or query text.
# `just telemetry-up` starts a local Langfuse and prints these three lines for it; the keys
# below are its local-only defaults.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3010/api/public/otel
# The same endpoint as the containers of the local stack reach it (a service name).
# EKG_TELEMETRY_STACK_ENDPOINT=http://langfuse-web:3000/api/public/otel
# Headers of every export, `key=value` pairs separated by commas, values percent-encoded.
# Langfuse wants HTTP Basic of `public key:secret key`, and its ingestion version.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20cGstbGYtZWtnLWxvY2FsOnNrLWxmLWVrZy1sb2NhbA==,x-langfuse-ingestion-version=4
# The service name on the engine's spans (the runtime's is `ekg-cognition-runtime`).
# OTEL_SERVICE_NAME=ekg-engine
# The local Langfuse's port, keys and login, when the defaults do not suit.
# LANGFUSE_PORT=3010
# LANGFUSE_PUBLIC_KEY=pk-lf-ekg-local
# LANGFUSE_SECRET_KEY=sk-lf-ekg-local
# LANGFUSE_USER_EMAIL=operator@ekg.local
# LANGFUSE_USER_PASSWORD=ekg-local-only

# --- Vector projection (optional; Qdrant) ---
# A non-authoritative read model: a second consumer of the RdfChanged fan-out
# grounds each changed entity (least-privilege read-policy), embeds it via the
# provider-neutral boundary, and upserts a vector into Qdrant. Rebuildable by
# replaying the stream; never a source of truth.
#   off: the default; no Qdrant needed (just check / default backend run).
#   on:  run the projection consumer on whichever bus EKG_EVENT_BUS selects.
# Unknown values fail loud at startup. Collection width = EMBED_DIM.
EKG_VECTOR_PROJECTION=off
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ekg_rdf

# --- Source system: Odoo ---
ODOO_URL=http://localhost:8069
ODOO_DB=ekg
ODOO_USER=
# An Odoo API key (res.users.apikeys, scope `rpc`), sent as a Bearer token on the
# json2 external API (Odoo 19), not the login password. Auto-managed: `just
# podman-local-up` mints one (name `ekg-local`) and writes it here if this is empty
# or does not authenticate. Set it manually only to use a specific key.
ODOO_API_KEY=

# --- Ingestion (governed source, materialize, notify) ---
# Shared secret every Odoo webhook must present (header x-ekg-webhook-secret).
# Any non-empty value works locally; `just backend` reads it from here.
EKG_WEBHOOK_SECRET=dev-secret

# --- Agent tool gateway ---
# The engine's internal MCP listener agents read the world model through (/mcp, never
# part of /api). Default 8091.
# EKG_TOOL_GATEWAY_PORT=8091
# The secret task tokens are signed with: at least 32 bytes. Unset = a random
# per-process secret (enough for one engine; several replicas, or host tests minting
# tokens, must share one). Auto-managed: `just podman-local-up` generates one here when
# empty.
EKG_TOOL_TOKEN_SECRET=

# --- Agent evals (`just agent-eval`; see evals/agent/README.md) ---
# A run calls the real model with MODEL_API_KEY (or AGENT_MODEL_API_KEY) and reads
# GRAPHDB_URL above. Trials per case, default 3.
# EKG_AGENT_EVAL_TRIALS=3
# No further trial starts once this many tokens were used. Default 2000000.
# EKG_AGENT_EVAL_MAX_TOKENS=2000000
# Where the run's own tool gateway listens, and where its runtime container is published.
# EKG_AGENT_EVAL_GATEWAY_PORT=8791
# EKG_AGENT_EVAL_RUNTIME_PORT=1417
# Where the run reaches the runtime; `just agent-eval` sets it from the port above.
# EKG_AGENT_EVAL_RUNTIME_URL=http://localhost:1417
# The step limit of one agent run, here as for shadow runs. Default 12.
# EKG_AGENT_MAX_STEPS=12
# A portfolio's (a joint case's) findings come from the semantic layer. An investigator reads a
# member only where it cannot decide, and planners read nothing. The planner's step limit (default 8) and how long it may take (default
# 120, at most 570), then the same for an investigator (default 10 and 240, at most 570).
# EKG_AGENT_JOINT_MAX_STEPS=8
# EKG_AGENT_JOINT_RUN_SECS=120
# EKG_AGENT_ANALYST_MAX_STEPS=10
# EKG_AGENT_ANALYST_RUN_SECS=240
# Planners side by side in one round, one per strategy (default 3, at most 3), and whether they
# get read tools (default false).
# EKG_AGENT_PLANNERS=3
# EKG_AGENT_PLANNER_READS=false
# The most characters of a record's text (a name, a description) an agent run is handed. A
# longer text is withheld and its length named. Default 80, at least 20.
# EKG_AGENT_TEXT_MAX_CHARS=80

# --- Policy-tiered promotion ---
# Action types a human-authored policy pre-authorizes to auto-promote after a
# proposal is attached, comma-separated. Empty (the default) = fully human-gated:
# every proposal waits for a human. Only reversible verbs can auto-promote (the
# policy engine enforces it), so a non-reversible verb here is ignored. Auto-promotion
# still commits via a governed PromotedAction and is audited with the policy as
# promoter.
#
# The local stack (deploy/podman/local/compose.yaml) opts in to a demo policy when
# these are empty or unset: expedite_po + notify_owner, cost limit 250 USD, so a
# fresh stack shows both a plan for a human and changes the agent applied. To gate
# every plan locally, name no verb: EKG_AUTOPROMOTE_ACTIONS=none. A backend run
# outside the local stack (`just backend`) reads these as-is: empty = human-gated.
EKG_AUTOPROMOTE_ACTIONS=
# The auto-apply cost limit, in the currency below. Unset = every priced change is
# human-gated (fails closed). The local stack's demo value is 250.
# EKG_AUTOPROMOTE_COST_LIMIT=250
# The currency the auto-apply cost limit is stated in, as the Plant Pulse policy note
# shows it (ISO 4217; default the seed's currency, USD).
# EKG_AUTOPROMOTE_COST_LIMIT_CURRENCY=USD

# --- Read-policy & omissions ---
# Role+purpose grounding filter: a reader not in the privileged roles has the
# sensitive edges/nodes hidden, recorded as structured omissions the agent must
# surface and the promote gate enforces. Comma-separated. Defaults reproduce the demo
# (a non-procurement planner gets unit_price/supplier hidden).
# Node type IRIs are PascalCase of the field (supplier becomes ekg:Supplier); edge type
# IRIs are the predicate as-is (unit_price becomes ekg:unit_price).
EKG_READ_POLICY_ID=read-policy/demo-v1
EKG_READ_POLICY_PRIVILEGED_ROLES=procurement
EKG_READ_POLICY_SENSITIVE_EDGES=unit_price
EKG_READ_POLICY_SENSITIVE_NODES=supplier
